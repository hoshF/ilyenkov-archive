---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionLayout from '../components/SectionLayout.astro';
import {
  getPublicIfiNetwork,
  getPublicReadingsSeries,
  getPublicResearchers,
} from '../lib/research-records';

const readingsSeriesRecords = getPublicReadingsSeries();
if (readingsSeriesRecords.length !== 1) throw new Error('Expected exactly one public Readings series');
const readingsSeries = readingsSeriesRecords[0];
const ifiNetwork = getPublicIfiNetwork();
const researcher = getPublicResearchers().find((record) => record.id === 'researcher-andrey-maidansky');
if (!researcher) throw new Error('Maidansky public researcher profile is missing');
---

<BaseLayout title="研究" description="连接国际伊里因科夫研究、会议、组织和中文介绍。">
  <SectionLayout pinned modifier="compact-intro research-hub">
    <header class="page-header" slot="intro">
      <h1 class="page-title">研究</h1>
    </header>

    <section class="research-series" aria-labelledby="ifi-heading">
        <h2 id="ifi-heading"><a href="/research/ifi/">{ifiNetwork.title}</a></h2>
        <p class="record__original">{ifiNetwork.name}（{ifiNetwork.abbreviation}）</p>
        <p class="record__summary">{ifiNetwork.summary}</p>
    </section>

    <section class="research-series" aria-labelledby="researcher-andrey-maidansky-heading">
        <h2 id="researcher-andrey-maidansky-heading"><a href="/research/researchers/andrey-maidansky/">{researcher.name}</a></h2>
        <p class="record__original">{researcher.originalName}</p>
        {researcher.editorial && <p class="record__summary">{researcher.editorial.workDescription}</p>}
    </section>

    <section class="research-series" aria-labelledby="readings-heading">
        <h2 id="readings-heading"><a href="/research/readings/">{readingsSeries.title}</a></h2>
        <p class="record__original">{readingsSeries.name}</p>
        <p class="record__summary">{readingsSeries.summary}</p>
    </section>



  </SectionLayout>
</BaseLayout>
