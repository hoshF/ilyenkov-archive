---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionLayout from '../components/SectionLayout.astro';
import { researcherSlug } from '../lib/portrait';
import { getPublicResearchers, getPublicIfiNetwork } from '../lib/research-records';
import { getReadingsPageSeries } from '../lib/readings-page';

const researchers = getPublicResearchers();
const readingsSeries = getReadingsPageSeries();
const ifiNetwork = getPublicIfiNetwork();
---

<BaseLayout title="研究" description="连接国际伊里因科夫研究、会议、组织和中文介绍。">
  <SectionLayout pinned modifier="section-index research-hub">
    <h1 class="visually-hidden">研究</h1>

    <section class="research-series" id="researchers" aria-labelledby="researchers-heading">
      <h2 id="researchers-heading">研究者</h2>
      <ul class="record-list research-hub__entries" role="list">
        {researchers.map((researcher) => (
          <li>
            <article aria-labelledby={`${researcher.id}-heading`}>
              <h3 class="record__title" id={`${researcher.id}-heading`}><a href={`/research/researchers/${researcherSlug(researcher)}/`}>{researcher.name}</a></h3>
              <p class="record__original">{researcher.originalName}</p>
              <p class="record__summary">{researcher.editorial?.workDescription ?? researcher.summary}</p>
            </article>
          </li>
        ))}
      </ul>
    </section>

    <section class="research-series" aria-labelledby="ifi-heading">
      <h2 id="ifi-heading">学术网络</h2>
      <div class="research-hub__entries">
        <h3 class="record__title"><a href="/research/ifi/">{ifiNetwork.title}</a></h3>
        <p class="record__original">{ifiNetwork.name}（{ifiNetwork.abbreviation}）</p>
        <p class="record__summary">{ifiNetwork.summary}</p>
      </div>
    </section>

    <section class="research-series" aria-labelledby="readings-heading">
      <h2 id="readings-heading">学术会议</h2>
      <div class="research-hub__entries">
        <h3 class="record__title"><a href="/research/readings/">{readingsSeries.title}</a></h3>
        <p class="record__original">{readingsSeries.name}</p>
        <p class="record__summary">{readingsSeries.summary}</p>
      </div>
    </section>
  </SectionLayout>
</BaseLayout>
