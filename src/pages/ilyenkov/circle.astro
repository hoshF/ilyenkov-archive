---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SectionLayout from '../../components/SectionLayout.astro';
import { formatHistoricalPeriod, getPublicCircle } from '../../lib/research-records';

const circle = getPublicCircle();
const headingIds = {
  military_service: 'military-heading',
  hegel_congress: 'hegel-heading',
};
const sourceLabel = (source: { creator: string | null; title: string }) => (
  source.creator ? `${source.creator}：《${source.title}》` : source.title
);
---

<BaseLayout title="交往与活动" description={circle.description}>
  <SectionLayout pinned modifier="compact-intro">
    <Breadcrumbs slot="breadcrumb" items={[
      { label: '伊里因科夫', href: '/ilyenkov/' },
      { label: '交往与活动' },
    ]} />
    <header class="page-header" slot="intro">
      <h1 class="page-title">交往与活动</h1>
    </header>

    {circle.sections.map((section) => (
      <section class="activity-section" aria-labelledby={headingIds[section.recordKind]}>
        <h2 id={headingIds[section.recordKind]}>{section.title}</h2>
        <p class="activity-section__lead">{section.lead}</p>
        <ol class="record-list">
          {section.records.map((record) => (
            <li>
              <article>
                <p class="record__meta">{formatHistoricalPeriod(record.period)}{record.location && <> · {record.location}</>}</p>
                <h3 class="record__title">{record.title}</h3>
                <p class="record__summary">{record.summary}</p>
                {record.status && <p class="record__note">{record.status}</p>}
                <p class="record__sources">来源：{record.sources.map((source, index) => <><a href={source.url}>{sourceLabel(source)}</a>{index < record.sources.length - 1 && '；'}</>)}</p>
              </article>
            </li>
          ))}
        </ol>
      </section>
    ))}
  </SectionLayout>
</BaseLayout>
