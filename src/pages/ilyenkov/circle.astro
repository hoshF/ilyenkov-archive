---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SectionLayout from '../../components/SectionLayout.astro';
import { formatHistoricalPeriod, getPublicResearchRecords } from '../../lib/research-records';

const { military, congresses } = getPublicResearchRecords();
const sourceLabel = (source: { creator: string | null; title: string }) => (
  source.creator ? `${source.creator}：《${source.title}》` : source.title
);
---

<BaseLayout title="交往与活动" description="伊里因科夫目前已公开的服役与国际黑格尔大会记录。">
  <SectionLayout pinned>
    <Breadcrumbs slot="breadcrumb" items={[
      { label: '伊里因科夫', href: '/ilyenkov' },
      { label: '交往与活动' },
    ]} />
    <header class="page-header" slot="intro">
      <h1 class="page-title">交往与活动</h1>
      <p class="lead">伊里因科夫的战时服役经历与国际黑格尔大会活动。</p>
    </header>

    <section class="activity-section" aria-labelledby="military-heading">
        <h2 id="military-heading">服役经历</h2>
        <p class="activity-section__lead">卫国战争期间的从军、战地服役与复员记录。</p>
        <ol class="record-list">
          {military.map((record) => (
            <li>
              <article>
                <p class="record__meta">{formatHistoricalPeriod(record.period)}</p>
                <h3 class="record__title">{record.title}</h3>
                <p class="record__summary">{record.summary}</p>
                <p class="record__sources">来源：{record.sources.map((source, index) => <><a href={source.url}>{sourceLabel(source)}</a>{index < record.sources.length - 1 && '；'}</>)}</p>
              </article>
            </li>
          ))}
        </ol>
    </section>

    <section class="activity-section" aria-labelledby="hegel-heading">
        <h2 id="hegel-heading">国际黑格尔大会</h2>
        <p class="activity-section__lead">参会、报告与会议文集论文。</p>
        <ol class="record-list">
          {congresses.map((record) => (
            <li>
              <article>
                <p class="record__meta">{formatHistoricalPeriod(record.period)} · {record.location}</p>
                <h3 class="record__title">{record.title}</h3>
                <p class="record__summary">{record.summary}</p>
                <p class="record__note">{record.status}</p>
                <p class="record__sources">来源：{record.sources.map((source, index) => <><a href={source.url}>{sourceLabel(source)}</a>{index < record.sources.length - 1 && '；'}</>)}</p>
              </article>
            </li>
          ))}
        </ol>
    </section>
  </SectionLayout>
</BaseLayout>
