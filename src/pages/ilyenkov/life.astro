---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SectionLayout from '../../components/SectionLayout.astro';
import {
  getPublicBiographyRecords,
  getPublicResearchRecords,
  getPublicWorks,
} from '../../lib/research-records';

const { military, congresses } = getPublicResearchRecords();
const biography = getPublicBiographyRecords();
const works = getPublicWorks();
const biographyById = new Map(biography.map((record) => [record.id, record]));
const biographyRecord = (id: string) => {
  const record = biographyById.get(id);
  if (!record) throw new Error(`Missing public biography event: ${id}`);
  return record;
};
const birth = biographyRecord('biography-1924-birth');
const studyStart = biographyRecord('biography-1941-school-university-evacuation');
const graduation = biographyRecord('biography-1950-graduation-postgraduate-recommendation');
const postgraduate = biographyRecord('biography-1950-1953-postgraduate-dissertation');
const institute = biographyRecord('biography-1953-institute-of-philosophy');
const militaryStart = military[0]?.period.start.slice(0, 4);
const militaryEnd = military.at(-1)?.period.end.slice(0, 4);
const congressStart = congresses[0]?.period.start.slice(0, 4);
const congressEnd = congresses.at(-1)?.period.end.slice(0, 4);
const workYears = [...new Set(works.map((work) => work.year))].sort();
const workTypeOrder = ['战时写作', '论文', '著作'];
const workTypes = [...new Set(works.map((work) => work.type))].sort((left, right) => (
  workTypeOrder.indexOf(left) - workTypeOrder.indexOf(right)
));
---

<BaseLayout title="生平" description="伊里因科夫目前已公开、可核验的生平坐标。">
  <SectionLayout pinned>
    <Breadcrumbs slot="breadcrumb" items={[
      { label: '伊里因科夫', href: '/ilyenkov' },
      { label: '生平' },
    ]} />
    <header class="page-header" slot="intro">
      <h1 class="page-title">生平</h1>
      <p class="lead">伊里因科夫的生平经历、哲学学习与早期学术工作。</p>
      <p class="section-note">本页记录 1924—1953 年间的经历。</p>
    </header>

    <ol class="record-list">
      <li>
        <article>
          <p class="record__meta">{birth.period.start.slice(0, 4)}—{studyStart.period.start.slice(0, 4)}</p>
          <h2 class="record__title">出生、童年与开始哲学学习</h2>
          <p class="record__summary">{birth.summary}{studyStart.summary}</p>
          <p class="record__links"><a href="/ilyenkov/timeline">在年表中查看</a></p>
        </article>
      </li>

      <li>
        <article>
          <p class="record__meta">{militaryStart}—{militaryEnd}</p>
          <h2 class="record__title">战时服役与返回大学</h2>
          <p class="record__summary">记录涵盖应征与炮兵学校、前线与部队经历、在《红星报》编辑部的工作，以及复员后返回大学。</p>
          <p class="record__links"><a href="/ilyenkov/circle">查看服役记录</a><a href="/ilyenkov/timeline">在年表中查看</a></p>
        </article>
      </li>

      <li>
        <article>
          <p class="record__meta">{militaryEnd}—{institute.period.start.slice(0, 4)}</p>
          <h2 class="record__title">大学、研究生阶段与学术起点</h2>
          <p class="record__summary">复员后返回莫斯科大学继续学习。{graduation.summary}{postgraduate.summary}{institute.summary}</p>
          <p class="record__links"><a href="/ilyenkov/timeline">在年表中查看</a></p>
        </article>
      </li>

      <li>
        <article>
          <p class="record__meta">{workYears.join('、')}</p>
          <h2 class="record__title">理论著作与战时写作</h2>
          <p class="record__summary">作品目录收录{workTypes.join('、')}及其年份与来源。</p>
          <p class="record__links"><a href="/ilyenkov/works">查看作品目录</a></p>
        </article>
      </li>

      <li>
        <article>
          <p class="record__meta">{congressStart}—{congressEnd}</p>
          <h2 class="record__title">国际黑格尔大会</h2>
          <p class="record__summary">记录伊里因科夫与国际黑格尔大会的联系，包括参会、报告和会议文集论文。</p>
          <p class="record__links"><a href="/ilyenkov/circle">查看大会记录</a><a href="/ilyenkov/timeline">在年表中查看</a></p>
        </article>
      </li>
    </ol>
  </SectionLayout>
</BaseLayout>
