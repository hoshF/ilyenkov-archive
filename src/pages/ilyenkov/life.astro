---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SectionLayout from '../../components/SectionLayout.astro';
import { getPublicLife } from '../../lib/research-records';

const life = getPublicLife();
const linkTargets = {
  timeline: '/ilyenkov/timeline/',
  circle: '/ilyenkov/circle/',
  works: '/ilyenkov/works/',
};
---

<BaseLayout title="生平" description={life.description}>
  <SectionLayout pinned>
    <Breadcrumbs slot="breadcrumb" items={[
      { label: '伊里因科夫', href: '/ilyenkov/' },
      { label: '生平' },
    ]} />
    <header class="page-header" slot="intro">
      <h1 class="page-title">生平</h1>
      <p class="lead">{life.lead}</p>
      <p class="section-note">{life.note}</p>
    </header>

    <ol class="record-list">
      {life.stages.map((stage) => (
        <li>
          <article>
            {stage.period && <p class="record__meta">{stage.period.start.slice(0, 4)}—{stage.period.end.slice(0, 4)}</p>}
            {stage.years && stage.years.length > 0 && <p class="record__meta">{stage.years.join('、')}</p>}
            <h2 class="record__title">{stage.title}</h2>
            {stage.summary && <p class="record__summary">{stage.summary}</p>}
            {stage.links.length > 0 && <p class="record__links">{stage.links.map((link) => <a href={linkTargets[link.target]}>{link.label}</a>)}</p>}
          </article>
        </li>
      ))}
    </ol>
  </SectionLayout>
</BaseLayout>
