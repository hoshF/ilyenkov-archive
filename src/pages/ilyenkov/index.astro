---
import { ilyenkov } from '../../lib/editorial';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionLayout from '../../components/SectionLayout.astro';

const entrances = [
  {
    href: '/ilyenkov/life',
    label: '生平',
    scope: '1924—1953',
    summary: '生平经历、哲学学习与早期学术工作。',
  },
  {
    href: '/ilyenkov/timeline',
    label: '年表',
    scope: '生平 · 服役 · 国际活动',
    summary: '按时间梳理他的生平、服役与国际活动。',
  },
  {
    href: '/ilyenkov/works',
    label: '作品目录',
    scope: '著作 · 论文 · 战时写作',
    summary: '著作、论文与战时写作的原文题名、年份和来源。',
  },
  {
    href: '/ilyenkov/circle',
    label: '交往与活动',
    scope: '服役 · 国际会议',
    summary: '卫国战争中的服役经历，以及参加国际黑格尔大会的记录。',
  },
];
---

<BaseLayout title={ilyenkov.identity} description="面向中文读者的伊里因科夫人物、年表、作品与交往入口。">
  <SectionLayout pinned>
    <header class="page-header" slot="intro">
      <h1 class="page-title">{ilyenkov.identity}</h1>
      <p class="record__original">{ilyenkov.originalName} · {ilyenkov.lifespan}</p>
    </header>

    <div class="prose prose--section person-intro">
      {ilyenkov.introduction.map((paragraph, index) => <p>{index === 0
        ? <><strong>{paragraph.slice(0, paragraph.indexOf('。') + 1)}</strong>{paragraph.slice(paragraph.indexOf('。') + 1)}</>
        : paragraph}</p>)}
    </div>

    <nav class="entrance-grid" aria-label="伊里因科夫栏目入口">
      {entrances.map((entrance) => (
        <a class="entrance-card" href={entrance.href}>
          <span class="entrance-card__label">{entrance.label}</span>
          <span class="entrance-card__scope">{entrance.scope}</span>
          <span class="entrance-card__summary">{entrance.summary}</span>
        </a>
      ))}
    </nav>
  </SectionLayout>
</BaseLayout>
