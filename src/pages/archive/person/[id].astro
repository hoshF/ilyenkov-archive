---
import ArchiveIndexView from '../../../components/ArchiveIndexView.astro';
import { getSiteData } from '../../../lib/site-data';

export async function getStaticPaths() {
  const { facets } = await getSiteData();
  return facets.persons.map((term) => ({
    params: { id: term.id },
    props: { term },
  }));
}

const { term } = Astro.props;
const { articles, facets } = await getSiteData();
const filtered = articles.filter((article) => article.persons.some((person) => person.id === term.id));
---

<ArchiveIndexView articles={filtered} facets={facets} current={{ kind: 'person', ...term }} />
