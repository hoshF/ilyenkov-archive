---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionLayout from '../../components/SectionLayout.astro';
import ReadingTocBehavior from '../../components/ReadingTocBehavior.astro';
import PageOutline from '../../components/PageOutline.astro';
import { READING_OUTLINE_MINIMUM, readingToc } from '../../lib/reading-toc';
import { getSiteData, type ReadableDocument } from '../../lib/site-data';
import { articleDiscussions, type ArticleDiscussion } from '../../lib/discussions';

export async function getStaticPaths() {
  const { articles } = await getSiteData();
  const discussions = articleDiscussions(articles.map((document) => document.id));
  const sibling = (candidate: ReadableDocument | undefined) => (
    candidate ? { title: candidate.title, route: candidate.route } : null
  );
  return articles.map((document, index) => ({
    params: { id: document.id },
    props: {
      document,
      previous: sibling(articles[index - 1]),
      next: sibling(articles[index + 1]),
      discussion: discussions.get(document.id) ?? null,
    },
  }));
}

interface Sibling { title: string; route: string; }
interface Props {
  document: ReadableDocument;
  previous: Sibling | null;
  next: Sibling | null;
  discussion: ArticleDiscussion | null;
}
const { document, previous, next, discussion } = Astro.props;
const description = `《${document.title}》的中文译文。`;

function finalUrlSegment(value: string): string {
  const pathname = new URL(value).pathname.replace(/\/$/, '');
  const segment = pathname.split('/').at(-1);
  if (!segment) return value;
  try {
    return decodeURIComponent(segment);
  } catch {
    return segment;
  }
}

const sourceLabel = document.sourceUrl ? finalUrlSegment(document.sourceUrl) : null;
const doiLabel = document.doiUrl?.replace(/^https?:\/\/doi\.org\//, '') ?? null;
const toc = readingToc(document.headings, document.html, {
  sourceInfo: { href: '#source-info-heading', label: '原文信息' },
});
---

<BaseLayout title={document.title} description={description} socialType="article" reading>
  <SectionLayout toc={toc} reading>
    <header data-pagefind-body class="document-header" slot="intro">
      <p class="record__meta">{document.year} · {document.authorLabel}</p>
      <h1 data-pagefind-meta={`title:${document.title}`} data-pagefind-weight="5" id="document-title" set:html={document.titleHtml} />
      <p class="document-header__original">{document.originalTitle}</p>
    </header>
    {/* 手机与平板不显示侧栏目录，改在页头之后给一份默认折叠的同一目录。 */}
    {toc.length >= READING_OUTLINE_MINIMUM && (
      <div class="reading-outline" slot="intro"><PageOutline label="本文目录" items={toc} /></div>
    )}

    {document.topics.map((term) => <span hidden data-pagefind-filter={`topic:${term.id}`} />)}
    {document.persons.map((term) => <span hidden data-pagefind-filter={`person:${term.id}`} />)}

    <article data-pagefind-body aria-labelledby="document-title">
      <div class="prose archive-prose" set:html={document.html} />
      <section class="prose source-info" aria-labelledby="source-info-heading">
        <hr />
        <h2 id="source-info-heading">原文信息</h2>
        <p>版本：{document.sourceEdition}</p>
        {document.sourceUrl && <p>原文：<a href={document.sourceUrl}>{sourceLabel}</a></p>}
        {document.doiUrl && <p>DOI号：<a href={document.doiUrl}>{doiLabel}</a></p>}
      </section>
    </article>

    {/* 论坛讨论入口：完整文章与原文信息之后、篇末导航之前；在搜索正文与页内目录之外，没有关联时不输出。 */}
    {discussion && (
      <p class="document-discussion"><a href={discussion.href}>{discussion.label}<span aria-hidden="true"> ↗</span></a></p>
    )}

    <nav class="document-nav" aria-label="档案导航">
      <p class="document-nav__back"><a href="/archive/">« 返回文本档案</a></p>
      {(previous || next) && (
        <div class="document-nav__siblings">
          <span class="document-nav__prev">{previous && <a href={previous.route}>« {previous.title}</a>}</span>
          <span class="document-nav__next">{next && <a href={next.route}>{next.title} »</a>}</span>
        </div>
      )}
    </nav>
  </SectionLayout>
</BaseLayout>

<ReadingTocBehavior />
