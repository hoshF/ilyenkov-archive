---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../lib/editorial';
import { getPublicIlyenkov } from '../lib/research-records';
import { getSiteData } from '../lib/site-data';
import { getGroupIssues } from '../lib/group';
import {
  getPublicResearchers,
  getPublicIfiNetwork,
  getPublicReadingsSeries,
} from '../lib/research-records';
import TextRecord from '../components/TextRecord.astro';
import UpdatesList from '../components/UpdatesList.astro';
import { getUpdates, HOME_UPDATES_LIMIT } from '../lib/updates';

const ilyenkov = getPublicIlyenkov();
const [{ articles }, issues] = await Promise.all([getSiteData(), getGroupIssues()]);
const texts = articles.slice(0, 4);
const recentWork = [...issues].sort((left, right) => (
  right.published.localeCompare(left.published) || right.issue - left.issue
)).slice(0, 3);
const maidansky = getPublicResearchers().find((record) => record.id === 'researcher-andrey-maidansky');
const ifi = getPublicIfiNetwork();
const readings = getPublicReadingsSeries().find((record) => record.id === 'ilyenkov-readings-series');
if (!maidansky || !readings) throw new Error('Homepage public research entities are missing');
const research = [
  { title: maidansky.name, summary: maidansky.summary, href: '/research/researchers/andrey-maidansky' },
  { title: ifi.title, summary: ifi.summary, href: '/research/ifi' },
  { title: readings.title, summary: readings.summary, href: '/research/readings' },
];
const updates = getUpdates().slice(0, HOME_UPDATES_LIMIT);
---

<BaseLayout title={site.name}>
  <div class="home-page">
    <div class="home-opening">
      <p class="home-positioning">伊里因科夫的中文译文与研究资料</p>
      <p class="home-summary">{ilyenkov.summary}</p>
      <p class="home-more">了解伊里因科夫：{ilyenkov.entrances.map((entrance, index) => <>{index > 0 && ' · '}<a href={`/ilyenkov/${entrance.target}`}>{entrance.label}</a></>)}</p>
    </div>

    <section class="home-content" aria-labelledby="content-heading">
      <h2 id="content-heading">文本</h2>
      <ol class="home-content__list">
        {texts.map((document) => (
          <li>
            <TextRecord document={document} mode="home" />
          </li>
        ))}
      </ol>
      <p class="home-more"><a href="/archive">浏览文本档案</a></p>
    </section>

    <section class="home-research" aria-labelledby="research-heading">
      <h2 id="research-heading">研究</h2>
      <ul class="home-content__list">
        {research.map((entry) => (
          <li>
            <h3 class="record__title"><a href={entry.href}>{entry.title}</a></h3>
            <p class="home-summary">{entry.summary}</p>
          </li>
        ))}
      </ul>
    </section>

    <section class="home-group" aria-labelledby="group-heading">
      <h2 id="group-heading">{site.group.name}</h2>
      <p class="home-summary">{site.group.summary}</p>
      <ol class="home-content__list">
        {recentWork.map((issue) => (
          <li>
            <p class="record__title"><a href={issue.route}>{issue.title}</a></p>
            <p class="record__meta">{issue.kind} · <time datetime={issue.published}>{issue.published}</time></p>
            <p class="home-summary">{issue.summary}</p>
          </li>
        ))}
      </ol>
      <p class="home-more"><a href="/group">小组工作</a> · <a href="/contact">关注与联系</a></p>
    </section>

    <section class="home-updates" aria-labelledby="updates-heading">
      <h2 id="updates-heading">近期动态</h2>
      {updates.length > 0
        ? <UpdatesList updates={updates} />
        : <p class="section-note">暂无公开动态。</p>}
      <p class="home-more"><a href="/updates">查看全部动态</a></p>
    </section>
  </div>
</BaseLayout>
