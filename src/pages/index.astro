---
import EssayExcerpt from '../components/EssayExcerpt.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../lib/editorial';
import { getSiteData } from '../lib/site-data';

const { articles } = await getSiteData();
const recent = articles.slice(0, 3);
---

<BaseLayout title={site.name}>
  <header class="home-masthead">
    <h1>{site.name}</h1>
    <p>面向中文世界的伊里因科夫资料、翻译与研究入口。</p>
  </header>

  <div class="home-shell">
    <section class="home-essays" aria-labelledby="recent-heading">
      <h3 id="recent-heading">已公开文本</h3>
      {recent.map((document) => <EssayExcerpt document={document} />)}
      {articles.length > recent.length && (
        <p class="home-archive-link"><a href="/archive">查看全部公开文本</a></p>
      )}
    </section>

    <aside class="home-sidebar">
      <section>
        <h3><a href="/about-us">关于</a></h3>
        <p>中文伊里因科夫小组围绕伊里因科夫的著作开展翻译、数字化与研究。</p>
        <p>他的文本在中文世界长期零散，多依赖转引和二手介绍，读者很难判断某段话出自哪里、依据的是哪个版本。这个网站把小组已经可以公开的译文、成书与研究线索集中在一处，并标明每一份材料的来源与状态。</p>
        <p class="home-about-link"><a href="/about-us">了解小组与网站</a></p>
      </section>
    </aside>
  </div>
</BaseLayout>
