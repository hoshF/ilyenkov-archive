---
import EssayExcerpt from '../components/EssayExcerpt.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../lib/editorial';
import { getSiteData } from '../lib/site-data';

const { articles } = await getSiteData();
const recent = articles.slice(0, 5);
---

<BaseLayout title={site.name}>
  <header class="home-masthead">
    <div class="home-mark" aria-label="网站标志预留位置"></div>
    <h1>{site.name}</h1>
  </header>

  <div class="home-shell">
    <section class="home-essays" aria-labelledby="recent-heading">
      <h3 id="recent-heading">Recent Essays</h3>
      {recent.map((document) => <EssayExcerpt document={document} />)}
      <p class="home-archive-link"><a href="/translations">进入完整文本档案 »</a></p>
    </section>

    <aside class="home-sidebar">
      <section>
        <h3>About</h3>
        <p>{site.description}</p>
        <p>研究在内部持续进行，适合公开的译文、研究、活动记录和出版成果在这里获得稳定形式。</p>
        <p class="home-sidebar__aside">研究、翻译与公开呈现。</p>
      </section>

      <section>
        <h3>Needs Some Love</h3>
        <ul>
          <li><a href="/start">第一次阅读伊里因科夫</a></li>
          <li><a href="/ilyenkov">人物、思想与历史语境</a></li>
          <li><a href="/works">伊里因科夫作品目录</a></li>
          <li><a href="/research">国际研究与讨论</a></li>
        </ul>
      </section>

      <section>
        <h3>Goodies</h3>
        <ul>
          {site.navigation.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
          <li><a href="/about">项目与权利</a></li>
        </ul>
      </section>
    </aside>
  </div>
</BaseLayout>
