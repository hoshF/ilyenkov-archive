---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../lib/editorial';
import { getSiteData } from '../lib/site-data';

const { articles } = await getSiteData();
const recent = articles.slice(0, 4);
---

<BaseLayout title={site.name}>
  <header class="home-masthead">
    <h1>{site.name}</h1>
    <p>面向中文世界的伊里因科夫资料、翻译与研究入口。</p>
  </header>

  <div class="home-shell">
    <section class="home-intro" aria-labelledby="intro-heading">
      <h2 id="intro-heading">从哪里开始</h2>
      <p>埃瓦尔德·瓦西里耶维奇·伊里因科夫一生追问的核心，是思维如何把握现实：抽象与具体如何转化，逻辑范畴从哪里来，《资本论》使用的究竟是怎样一种方法。他的回答集中在 1960 年的《〈资本论〉中的抽象和具体辩证法》与 1974 年的《辩证逻辑：历史与理论纲要》里。</p>
      <p>这些文本在中文世界长期零散，多依赖转引和二手介绍，读者很难判断某段话出自哪里、依据的是哪个版本。中文伊里因科夫小组围绕他的著作开展翻译、数字化与研究，把已经可以公开的材料集中在一处，并为每一份标明来源与状态。</p>
      <p>要认识这个人，从<a href="/ilyenkov">伊里因科夫</a>开始：那里有生平坐标、年表、作品目录与他置身其中的活动。要读文本，去<a href="/archive">档案</a>。要看小组制作的成书，去<a href="/books">书籍</a>。要接上国际研究，去<a href="/research">研究</a>。</p>
      <p class="home-about-link"><a href="/about-us">了解小组与网站</a></p>
    </section>

    <aside class="home-sidebar" aria-labelledby="recent-heading">
      <h3 id="recent-heading">最近的文章</h3>
      <ol class="home-recent">
        {recent.map((article) => (
          <li><a href={article.route}>{article.title}</a></li>
        ))}
      </ol>
      {articles.length > recent.length && (
        <p class="home-archive-link"><a href="/archive">查看全部文章</a></p>
      )}
    </aside>
  </div>
</BaseLayout>
