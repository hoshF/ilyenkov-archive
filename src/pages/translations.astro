---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getSiteData } from '../lib/site-data';

const { articles } = await getSiteData();
---

<BaseLayout title="文本档案" description="伊里因科夫著作、中文译文及相关研究译文的公开档案。">
  <div class="container archive-page">
    <header class="page-header">
      <h1 class="page-title">文本档案</h1>
    </header>

    <div class="archive-years">
      <section class="archive-year" aria-label="公开文本">
        <ol>
          {articles.map((article) => (
            <li><a href={article.route}>{article.title}</a></li>
          ))}
        </ol>
      </section>
    </div>

  </div>
</BaseLayout>
