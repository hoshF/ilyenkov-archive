---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SectionLayout from '../../components/SectionLayout.astro';
import { getBooks, type Book } from '../../lib/books';

export async function getStaticPaths() {
  const books = await getBooks();
  return books.map((book) => ({
    params: { id: book.id },
    props: { book },
  }));
}

interface Props { book: Book; }
const { book } = Astro.props;
const editions = [...book.editions].reverse();
---

<BaseLayout title={book.title} description={`《${book.title}》的出版身份、版次记录与译者引言。`}>
  <SectionLayout pinned modifier="book-page">
    <aside class="book-edition-index" slot="aside" aria-labelledby="book-edition-index-heading">
      <p class="book-edition-index__heading" id="book-edition-index-heading">版次记录</p>
      <ul class="book-edition-index__list">
        {editions.map((edition) => (
          <li>
            <p class="book-edition-index__version">{edition.version}</p>
            <time datetime={edition.date}>{edition.date}</time>
          </li>
        ))}
      </ul>
    </aside>

    <Breadcrumbs slot="breadcrumb" items={[
      { label: '书籍', href: '/books' },
      { label: book.title },
    ]} />

    <article>
      <header class="book-header">
        <div class="book-header__title">
          <h1>{book.title}</h1>
          {book.original_title && <p class="book-header__original">{book.original_title}</p>}
        </div>
      </header>

      <div class:list={['book-header__body', !book.cover && 'book-header__body--without-cover']}>
        {book.cover && (
          <div class="book-header__cover-panel">
            <a href="#cover" class="book-header__cover-link" aria-label={`查看《${book.title}》封面大图`}>
              <img class="book-header__cover" src={book.cover} alt={`《${book.title}》封面`} width="360" height="540" />
            </a>
            <a href="#" id="cover" class="cover-lightbox" aria-label="关闭大图">
              <img src={book.cover} alt={`《${book.title}》封面`} />
            </a>
          </div>
        )}

        <div class="book-header__identity">
          {/* 事实表只放“这本书是什么”：作者、原著初版年份、体裁、原文出处、版次、权利。
              本站对这份记录的维护形态（category）属于发布元数据，不在这里展示。
              体裁取 work_type，与 /books 列表页的“1997 · 专著”同一口径。 */}
          <dl class="fact-list">
            <div><dt>作者</dt><dd>{book.author}</dd></div>
            {book.original_year && <div><dt>原著初版</dt><dd>{book.original_year}</dd></div>}
            {book.work_type && <div><dt>体裁</dt><dd>{book.work_type}</dd></div>}
            {book.original_source && <div><dt>原文出处</dt><dd>{book.original_source}</dd></div>}
            <div class="book-detail__edition">
              <dt>当前版次</dt>
              <dd>
                <span class="book-detail__version">{book.latestEdition.version}</span>
                <span aria-hidden="true">·</span>
                <time datetime={book.latestEdition.date}>{book.latestEdition.date}</time>
              </dd>
            </div>
            <div class="book-detail__access">
              <dt>获取与权利</dt>
              <dd>
                {book.rights && <p>{book.rights}</p>}
                {book.download
                  ? <p><a href={book.download.href}>{book.download.label}</a></p>
                  : <p>本站不提供下载。</p>}
              </dd>
            </div>
          </dl>
        </div>

        <section class="prose prose--section book-introduction" aria-labelledby="introduction-heading">
          <h2 id="introduction-heading">译者引言</h2>
          <div set:html={book.introductionHtml} />
        </section>
      </div>

      <section class="book-editions" aria-labelledby="book-editions-heading">
        <h2 id="book-editions-heading">版次记录</h2>
        <ol class="record-list" role="list">
          {editions.map((edition) => (
            <li>
              <p class="record__meta"><time datetime={edition.date}>{edition.date}</time></p>
              <h3 class="record__title">{edition.version}</h3>
              {edition.note && <p class="record__note">{edition.note}</p>}
              {edition.checksum && <p class="book-checksum">{edition.checksum}</p>}
            </li>
          ))}
        </ol>
        {book.errata && book.errata.length > 0 && (
          <section class="prose prose--section book-errata" aria-labelledby="book-errata-heading">
            <h2 id="book-errata-heading">勘误</h2>
            <ul>{book.errata.map((item) => <li>{item}</li>)}</ul>
          </section>
        )}
      </section>
    </article>
  </SectionLayout>
</BaseLayout>
