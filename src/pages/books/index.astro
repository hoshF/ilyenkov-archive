---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionLayout from '../../components/SectionLayout.astro';
import BookCard from '../../components/BookCard.astro';
import { getBooks, groupBooks } from '../../lib/books';

const books = await getBooks();
const groups = groupBooks(books);
---

<BaseLayout title="书籍" description="由中文伊里因科夫小组制作并公开维护的成书记录。">
  <SectionLayout pinned>
    <header class="page-header" slot="intro">
      <h1 class="page-title">书籍</h1>
      <p class="lead">小组译作与数字化书籍的书目信息、版次记录和译者引言。</p>
    </header>

    {groups.length > 0 ? (
      <div class="books-shelf">
        {groups.map((group) => (
          <section
            class:list={['book-category', group.category === 'translation' && 'book-category--default']}
            aria-label={group.category === 'translation' ? '书籍目录' : undefined}
            aria-labelledby={group.category !== 'translation' ? `category-${group.category}` : undefined}
          >
            {group.category !== 'translation' && (
              <h2 id={`category-${group.category}`}>{group.label}</h2>
            )}

            {group.standalone.length > 0 && (
              <ul class="record-list">
                {group.standalone.map((book) => <BookCard book={book} />)}
              </ul>
            )}

            {group.collections.map((collection) => (
              <div class="book-collection">
                <h3>{collection.name}</h3>
                <ul class="record-list">
                  {collection.books.map((book) => <BookCard book={book} />)}
                </ul>
              </div>
            ))}
          </section>
        ))}
      </div>
    ) : (
      <div class="prose prose--page">
        <h2>当前状态</h2>
        <p>暂无公开的书籍记录。</p>
      </div>
    )}
  </SectionLayout>
</BaseLayout>
