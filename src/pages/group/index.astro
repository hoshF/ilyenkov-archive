---
import { site } from '../../lib/editorial';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionLayout from '../../components/SectionLayout.astro';
import { getGroupIssues, getGroupAnnouncement } from '../../lib/group';

const [issues, announcement] = await Promise.all([getGroupIssues(), getGroupAnnouncement()]);
---

<BaseLayout title={site.group.name} description={`${site.group.name}的公共工作档案，按期记录已公开的研究、讨论、资料整理与阶段性成果。`}>
  <SectionLayout modifier="section-index group-index">
    {/* 公告置顶，默认折叠成一行，不把小组名称压到下方；首页按公告标题的 id 链到这里，届时自动展开。 */}
    <details class="group-announcement" slot="intro" id={announcement.title.id} data-group-announcement>
      <summary>
        <span class="group-announcement__label">公告</span>
        <time datetime={announcement.published}>{announcement.published}</time>
        <span class="group-announcement__title">{announcement.title.text}</span>
        <span class="group-announcement__toggle" aria-hidden="true"></span>
      </summary>
      <div class="prose prose--section group-announcement__body" set:html={announcement.html} />
    </details>
    {/* 小组名称沿用首页定位句的字号，用正文黑色：这一页介绍的就是小组本身。外文名并作一行。 */}
    <header class="page-header group-heading" slot="intro">
      <h1 class="group-heading__title">{site.group.name}</h1>
      <p class="group-heading__names"><span>{site.group.originalName}</span> · <span>{site.group.englishName}</span></p>
      <nav class="intro-links" aria-label="关于小组">
        <ul>
          <li><a href="/group/0/">小组介绍</a></li>
          <li><a href={site.forumUrl}>讨论社区</a></li>
          <li><a href="/contact/">关注与联系</a></li>
        </ul>
      </nav>
    </header>

    <section class="group-issues" aria-labelledby="group-issues-heading">
      <h2 id="group-issues-heading">小组通讯</h2>

      {issues.length > 0 ? (
        /* 按期排列的通讯目录：期号、类型与日期，然后题名。题名是唯一入口，
           没有视觉编号、摘要和“阅读全文”。 */
        <ul class="record-list" role="list">
          {issues.map((issue) => (
            <li>
              <p class="record__meta">第 {issue.issue} 期 · {issue.kind} · <time datetime={issue.published}>{issue.published}</time></p>
              <p class="record__title"><a href={issue.route}>{issue.title}</a></p>
            </li>
          ))}
        </ul>
      ) : (
        <div class="prose prose--section">
          <p>暂无公开的小组通讯。</p>
        </div>
      )}
    </section>

  </SectionLayout>
</BaseLayout>

<script>
  // 从首页的公告链接（或任何指向公告锚点的地址）进入时展开公告。
  const announcement = document.querySelector<HTMLDetailsElement>('[data-group-announcement]');
  const openForHash = () => {
    if (announcement && decodeURIComponent(window.location.hash.slice(1)) === announcement.id) announcement.open = true;
  };
  openForHash();
  window.addEventListener('hashchange', openForHash);
</script>
