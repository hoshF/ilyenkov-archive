---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionLayout from '../../components/SectionLayout.astro';
import { getGroupIssues } from '../../lib/group';

const issues = await getGroupIssues();
---

<BaseLayout title="中文伊里因科夫小组" description="中文伊里因科夫小组的公共工作档案，按期记录已公开的研究、讨论、资料整理与阶段性成果。">
  <SectionLayout pinned modifier="group-index">
    <header class="page-header" slot="intro">
      <h1 class="page-title">中文伊里因科夫小组</h1>
      <p class="lead">中文伊里因科夫小组围绕伊里因科夫及相关苏联哲学文本开展资料整理、翻译、校订、研究与讨论。本页按期记录小组公开的研究、活动和阶段性成果。</p>
      <p class="section-note"><a href="/contact/">关注与联系</a></p>
    </header>

    <section class="group-issues" aria-labelledby="group-issues-heading">
      <h2 id="group-issues-heading">小组工作</h2>

      {issues.length > 0 ? (
        /* 按期排列的工作目录：每条只留“期号 + 日期”和题名，题名是唯一入口。
           没有视觉编号、摘要和“阅读全文”——列表只显示帮助辨认期目的信息。 */
        <ul class="record-list" role="list">
          {issues.map((issue) => (
            <li>
              <p class="record__meta">第 {issue.issue} 期 · <time datetime={issue.published}>{issue.published}</time></p>
              <p class="record__title"><a href={issue.route}>{issue.title}</a></p>
            </li>
          ))}
        </ul>
      ) : (
        <div class="prose prose--section">
          <p>暂无公开的小组工作记录。</p>
        </div>
      )}
    </section>

  </SectionLayout>
</BaseLayout>
