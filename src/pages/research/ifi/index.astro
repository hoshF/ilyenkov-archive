---
import { renderPublicMarkdown } from '../../../lib/markdown';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import PageOutline from '../../../components/PageOutline.astro';
import RecordSources from '../../../components/RecordSources.astro';
import ResearchNav from '../../../components/ResearchNav.astro';
import ResourceLinks from '../../../components/ResourceLinks.astro';
import SectionLayout from '../../../components/SectionLayout.astro';
import {
  formatHistoricalPeriod,
  getPublicIfiNetwork,
  getPublicIfiSymposiums,
  type PublicIfiNetwork,
} from '../../../lib/research-records';

const network = getPublicIfiNetwork();
const symposiums = getPublicIfiSymposiums();
const introduction = network.editorial
  ? await renderPublicMarkdown(network.editorial.introduction.join('\n\n'))
  : null;
const groups = [
  { id: 'ifi-formation-heading', title: '网络形成背景', records: symposiums.filter((record) => record.id === network.formation.symposiumId) },
  { id: 'ifi-symposiums-heading', title: '专题研讨会', records: symposiums.filter((record) => record.id !== network.formation.symposiumId && record.status === 'confirmed') },
  { id: 'ifi-planned-heading', title: '计划活动', records: symposiums.filter((record) => record.status === 'planned') },
].filter((group) => group.records.length > 0);
const outline = [
  ...(introduction ? [{ href: '#ifi-intro-heading', label: '简介' }] : []),
  ...groups.map((group) => ({ href: `#${group.id}`, label: group.title })),
  { href: '#ifi-resources-heading', label: '资料入口' },
];
const resourceLabels: Record<PublicIfiNetwork['resources'][number]['kind'], string> = {
  about: '组织介绍',
  history: '历史与活动',
  texts: '伊里因科夫文本',
  symposiums: '研讨会资料',
  youtube: 'YouTube',
  facebook: 'Facebook',
};
const formatLabels = { in_person: '现场会议', online: '线上会议', hybrid: '现场与线上会议' };
---

<BaseLayout title={network.title} description={network.summary}>
  <SectionLayout modifier="section-index research-meetings">
    <Breadcrumbs slot="breadcrumb" items={[
      { label: '研究', href: '/research/' },
      { label: network.title },
    ]} />
    <header class="page-header" slot="intro">
      <ResearchNav current="ifi" />
      <h1 class="page-title">{network.title}</h1>
      <p class="record__original">{network.name}（{network.abbreviation}）</p>
    </header>

    <PageOutline label="浏览网络与研讨会" items={outline} />
    {introduction && <section class="research-series" aria-labelledby="ifi-intro-heading">
      <h2 id="ifi-intro-heading">简介</h2>
      <div class="prose prose--section" set:html={introduction.html} />
    </section>}

    {network.editorial && <p class="research-meetings__note">{network.editorial.symposiumsLead}</p>}
    {groups.map((group) => (
      <section class="research-series research-meetings-section" aria-labelledby={group.id}>
        <h2 id={group.id}>{group.title}</h2>
        <ol class="record-list">
          {group.records.map((record) => (
            <li id={record.id}>
              <article class="timeline-record">
                <div class="timeline-record__date">
                  <p class="record__meta">{formatHistoricalPeriod(record.period)}</p>
                </div>
                <div class="timeline-record__content">
                  <h3 class="record__title">{record.title}</h3>
                  <p class="record__label">{record.context} · {record.location} · {formatLabels[record.format]}</p>
                  {record.status === 'planned' && <p class="record__note">计划举行；会期与安排以主办方公告为准。</p>}
                  <RecordSources sources={record.sources} label="资料来源" />
                </div>
              </article>
            </li>
          ))}
        </ol>
      </section>
    ))}

    <div class="research-meetings__resources">
      <ResourceLinks id="ifi-resources-heading" label="资料入口"
        links={[{ label: '官方网站', href: network.url }, ...network.resources.map((resource) => ({ label: resourceLabels[resource.kind], href: resource.url }))]} />
    </div>
  </SectionLayout>
</BaseLayout>
