---
import { ifiEditorial } from '../../../lib/editorial';
import { renderPublicMarkdown } from '../../../lib/markdown';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import ResourceLinks from '../../../components/ResourceLinks.astro';
import SectionLayout from '../../../components/SectionLayout.astro';
import {
  formatHistoricalPeriod,
  getPublicIfiNetwork,
  getPublicIfiSymposiums,
  type PublicIfiNetwork,
} from '../../../lib/research-records';

const network = getPublicIfiNetwork();
const symposiums = getPublicIfiSymposiums();
const introduction = await renderPublicMarkdown(ifiEditorial.introduction.join('\n\n'));

const resourceLabels: Record<PublicIfiNetwork['resources'][number]['kind'], string> = {
  about: '组织介绍',
  history: '历史与活动',
  texts: '伊里因科夫文本',
  symposiums: 'Symposiums',
  youtube: 'YouTube',
  facebook: 'Facebook',
};
const sourceLabel = (source: { creator: string | null; title: string }) => (
  source.creator ? `${source.creator}：《${source.title}》` : source.title
);
---

<BaseLayout title={network.title} description={network.summary}>
  <SectionLayout modifier="entity-detail research-profile" pinned>
    <ResourceLinks slot="aside" id="ifi-resources-heading" label="资料入口"
      links={[{ label: '官方网站', href: network.url }, ...network.resources.map((resource) => ({ label: resourceLabels[resource.kind], href: resource.url }))]} />
    <Breadcrumbs slot="breadcrumb" items={[
      { label: '研究', href: '/research' },
      { label: network.title },
    ]} />
    <header class="page-header" slot="intro">
      <h1 class="page-title">{network.title}</h1>
      <p class="record__original">{network.name}（{network.abbreviation}）</p>
    </header>

    <section class="research-series" aria-labelledby="ifi-intro-heading">
      <h2 id="ifi-intro-heading">简介</h2>
      <div class="prose prose--section" set:html={introduction.html} />
    </section>



    <section class="research-series" aria-labelledby="ifi-symposiums-heading">
      <h2 id="ifi-symposiums-heading">历次 Symposium</h2>
      <p class="research-series__lead">以下记录呈现 IFI 的主要历史节点。</p>
      <ol class="record-list">
        {symposiums.map((record) => (
          <li id={record.id}>
            <article>
              <p class="record__meta">{formatHistoricalPeriod(record.period)} · {record.location}</p>
              <p class="record__label">{record.context}</p>
              <h3 class="record__title">{record.title}</h3>
              <p class="record__sources">来源：{record.sources.map((source, index) => <><a href={source.url}>{sourceLabel(source)}</a>{index < record.sources.length - 1 && '；'}</>)}</p>
            </article>
          </li>
        ))}
      </ol>
    </section>
  </SectionLayout>
</BaseLayout>
