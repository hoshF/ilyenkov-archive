---
import { renderPublicMarkdown } from '../../../lib/markdown';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import PageOutline from '../../../components/PageOutline.astro';
import ResearcherLinks from '../../../components/ResearcherLinks.astro';
import TextRecord from '../../../components/TextRecord.astro';
import SectionLayout from '../../../components/SectionLayout.astro';
import { getPublicResearchers, type PublicResearcher } from '../../../lib/research-records';
import { getSiteData } from '../../../lib/site-data';
import { researcherPortrait, researcherSlug } from '../../../lib/portrait';

export function getStaticPaths() {
  return getPublicResearchers().map((researcher) => ({
    params: { slug: researcherSlug(researcher) },
    props: { researcher },
  }));
}
interface Props { researcher: PublicResearcher; }
const { researcher } = Astro.props;
const introduction = researcher.editorial
  ? await renderPublicMarkdown(researcher.editorial.introduction.join('\n\n')) : undefined;
const outline = [
  ...(introduction ? [{ href: '#researcher-intro-heading', label: '简介' }] : []),
  { href: '#researcher-translations-heading', label: '本站译文' },
];
const portrait = await researcherPortrait(researcher);
const { articles } = await getSiteData();
// 筛选保留 Archive 的统一顺序：原文年份降序，同年按中文题名、再按 id。
const translations = articles.filter((document) => document.authorIds.includes(researcher.personId));

---

<BaseLayout title={researcher.name} description={researcher.summary}>
  <SectionLayout modifier={`section-index entity-detail research-profile${portrait ? ' research-profile--portrait' : ''}`}>
    <Breadcrumbs slot="breadcrumb" items={[
      { label: '研究', href: '/research/' },
      { label: researcher.name },
    ]} />
    <header class="page-header" slot="intro">
      <h1 class="page-title">{researcher.name}</h1>
      <p class="record__original">
        {researcher.originalName}
        {researcher.latinName && <><br />{researcher.latinName}</>}
      </p>
      <ResearcherLinks resources={researcher.resources} />
      {portrait && <img class="researcher-portrait" src={portrait.src} alt={`${researcher.name}照片`} width="160" height="213" />}
    </header>

    <PageOutline label="浏览简介与本站译文" items={outline} />
    {introduction && <section class="research-series" aria-labelledby="researcher-intro-heading">
      <h2 id="researcher-intro-heading">简介</h2>
      <div class="prose prose--section" set:html={introduction.html} />
    </section>}

    <section class="research-series" aria-labelledby="researcher-translations-heading">
      <h2 id="researcher-translations-heading">本站译文</h2>
      {translations.length > 0 ? (
        <ol class="record-list">
          {translations.map((document) => (
            <li><TextRecord document={document} mode="researcher" /></li>
          ))}
        </ol>
      ) : (
        <div class="prose prose--section"><p>本站暂未公开这位研究者的译文。</p></div>
      )}
    </section>
  </SectionLayout>
</BaseLayout>
