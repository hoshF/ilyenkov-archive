---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="页面未找到" description="你访问的页面不存在或已经移动。">
  <div class="container">
    <header class="page-header">
      <h1 class="page-title">没有找到这个页面</h1>
      <p class="lead">你访问的地址不存在，或者页面已经移动。</p>
    </header>

    <p class="prose">回到<a href="/">首页</a>，或者到<a href="/archive">文本档案</a>查看已公开的译文与相关文本。</p>
  </div>
</BaseLayout>
