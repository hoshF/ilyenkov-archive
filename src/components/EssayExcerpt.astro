---
import type { ReadableDocument } from '../lib/site-data';

interface Props { document: ReadableDocument; }
const { document } = Astro.props;
const cleanText = (value: string) => value
  .replace(/<[^>]+>/g, ' ')
  .replace(/&nbsp;/g, ' ')
  .replace(/&amp;/g, '&')
  .replace(/&quot;/g, '"')
  .replace(/\*\*/g, '')
  .replace(/\s+/g, ' ')
  .trim();
const sectionParagraph = document.html.match(
  /<h2[^>]*>\s*(?:摘要|访谈)\s*<\/h2>\s*<p>([\s\S]*?)<\/p>/i,
)?.[1];
const sourceExcerpt = sectionParagraph
  ? cleanText(sectionParagraph)
  : cleanText(document.html);
const excerpt = sourceExcerpt.length > 180
  ? `${sourceExcerpt.slice(0, 180).trim()}……`
  : sourceExcerpt;
---

<article class="essay-excerpt">
  <h3><a href={document.route}>{document.title}</a></h3>
  <p>{excerpt} <a class="essay-excerpt__more" href={document.route}>Continue Reading »</a></p>
</article>
