---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionLayout from './SectionLayout.astro';
import type { ReadableDocument } from '../lib/site-data';
import type { TermWithArticles } from '../lib/archive-taxonomy';

/**
 * Archive 文库视图：分类目录在左侧辅助栏，栏目身份与文章列表同在居中的内容列。
 *
 * 三个路由共用它——/archive/（全部）、/archive/topic/<id>、/archive/person/<id>；
 * 路由文件只负责生成路径、挑出当前分类、把已按 canonical 顺序排好的文章传进来。
 * 页面不在这里排序，也不重复分类的展示状态。
 */

interface Props {
  articles: ReadableDocument[];
  facets: { topics: TermWithArticles[]; persons: TermWithArticles[] };
  /** 当前分类；全部文章时为 null。 */
  current?: { kind: 'topic' | 'person'; id: string; label: string; count: number } | null;
}

const { articles, facets, current = null } = Astro.props;
const here = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isCurrent = (href: string) => href.replace(/\/+$/, '') === here;
const groups = [
  { kind: 'topic' as const, label: '主题', terms: facets.topics },
  { kind: 'person' as const, label: '人物', terms: facets.persons },
].filter((group) => group.terms.length > 0);

// 文档元信息。facet 是同一个 Archive collection 的筛选视图，所以页面身份仍是「文本档案」，
// h1 不变；但它是独立的公开 URL，<title> 与 description 必须能与其它 facet 区分。
// 站名后缀由 BaseLayout 统一追加，这里不拼「｜中文伊里因科夫」。
const archiveTitle = '文本档案';
const archiveDescription = '伊里因科夫著作、中文译文及相关研究译文的公开档案。';
const title = current ? `${current.label}｜${archiveTitle}` : archiveTitle;
const description = current === null ? archiveDescription
  : current.kind === 'topic'
    ? `浏览文本档案中“${current.label}”主题下的公开中文译文与相关文本。`
    : `浏览文本档案中以“${current.label}”为中心人物的公开中文译文与相关文本。`;
---

<BaseLayout title={title} description={description}>
  <SectionLayout pinned modifier="archive-index-page">
    <header class="page-header" slot="intro">
      <h1 class="page-title">文本档案</h1>
      <p class="lead">伊里因科夫著作与相关研究的中文译文、数字化文本。</p>
    </header>

    <aside class="archive-facets" slot="aside" aria-labelledby="archive-facets-heading">
      <p class="archive-facets__label" id="archive-facets-heading">按分类浏览</p>

      <p class="archive-facets__all">
        <a href="/archive" aria-current={isCurrent('/archive') ? 'page' : undefined}>全部文章</a>
      </p>

      {groups.map((group) => (
        <nav class="archive-facets__group" aria-label={group.label}>
          <p class="archive-facets__label">{group.label}</p>
          <ul class="section-layout__structured archive-facets__terms">
            {group.terms.map((term) => (
              <li>
                <a
                  class="archive-facets__term"
                  href={term.href}
                  aria-current={isCurrent(term.href) ? 'page' : undefined}
                >
                  <span class="archive-facets__name">{term.label}</span>
                  <span class="archive-facets__count">{term.count}</span>
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ))}
    </aside>

    {articles.length > 0 ? (
      <section class="archive-year" aria-label="文章">
        <h2>文章</h2>
        {current && <p class="archive-facets__context">{current.label} · {current.count} 篇</p>}
        <ul class="record-list" role="list">
          {articles.map((article) => (
            <li>
              <p class="record__meta">{article.year} · {article.authorLabel}</p>
              <p class="record__title"><a href={article.route}>{article.title}</a></p>
            </li>
          ))}
        </ul>
      </section>
    ) : (
      <div class="prose prose--page">
        <h2>当前状态</h2>
        <p>暂无可公开阅读的文章。</p>
      </div>
    )}
  </SectionLayout>
</BaseLayout>
