---
export interface SectionTocItem {
  href: string;
  label: string;
}

interface Props {
  toc?: SectionTocItem[];
  /** 左栏固定在打开页面时的位置，只有右侧内容滚动。 */
  pinned?: boolean;
  /** 内容是连续正文而不是记录列表：内容栏收到行宽。 */
  reading?: boolean;
}

const { toc = [], pinned = false, reading = false } = Astro.props;
const indexed = toc.length > 0;
---

<div class:list={[
  'container',
  'section-layout',
  indexed && 'section-layout--indexed',
  reading && 'section-layout--reading',
  pinned && 'section-layout--pinned',
]}>
  <div class="section-layout__sidebar">
    {Astro.slots.has('breadcrumb') && (
      <div class="section-layout__breadcrumb">
        <slot name="breadcrumb" />
      </div>
    )}

    {Astro.slots.has('intro') && (
      <div class="section-layout__intro">
        <slot name="intro" />
      </div>
    )}

    {indexed && (
      <aside class="section-layout__toc">
        <nav aria-labelledby="section-toc-label">
          <p class="section-layout__toc-label" id="section-toc-label">页内目录</p>
          <ol>
            {toc.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
          </ol>
        </nav>
      </aside>
    )}
  </div>

  <div class="section-layout__content">
    <slot />
  </div>
</div>
