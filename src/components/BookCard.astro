---
import { BOOK_CATEGORY_LABELS, type Book } from '../lib/books';

interface Props { book: Book; }
const { book } = Astro.props;

/** 元信息一行：原著年份在前，体裁在后；没有单独标体裁时退回“译作/数字化文本”这一层分类。 */
const meta = [book.original_year, book.work_type ?? BOOK_CATEGORY_LABELS[book.category]].filter(Boolean);
---

<li>
  <p class="record__title">
    <a href={book.route}>
      《{book.title}》
      {book.volume_label && <span class="record__volume">{book.volume_label}</span>}
    </a>
  </p>
    {book.original_title && <span class="record__original" lang="ru">{book.original_title}</span>}
    <span class="record__meta record__meta--after">{meta.join(' · ')}</span>
</li>
