---
import type { Book } from '../lib/books';

interface Props { book: Book; }
const { book } = Astro.props;
---

<li class="book-card">
  <a href={book.route}>
    <span class="book-card__frame">
      {book.cover
        ? <img class="book-card__cover" src={book.cover} alt={`《${book.title}》封面`} loading="lazy" />
        : <span class="book-card__cover book-card__cover--blank" aria-hidden="true"></span>}
    </span>
    <span class="book-card__title">
      {book.title}
      {book.volume_label && <span class="book-card__volume">{book.volume_label}</span>}
    </span>
  </a>
</li>
