---
import '../styles/global.css';
import { site } from '../lib/editorial';

interface Props {
  title: string;
  description?: string;
  /** 连续阅读的页面：手机上只留正文，站点标题栏让开。 */
  reading?: boolean;
}

const {
  title,
  description = site.description,
  reading = false,
} = Astro.props;
const pageTitle = title === site.name ? title : `${title}｜${site.name}`;
const currentPath = Astro.url.pathname;
const current = (href: string) => (
  currentPath === href || currentPath.startsWith(`${href}/`)
);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" href="/favicon.ico?v=evi-1" type="image/x-icon" sizes="16x16 32x32" />
    <link rel="icon" href="/brand/evi-favicon-32.png?v=evi-1" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon.svg?v=evi-1" type="image/svg+xml" sizes="any" />
    <meta name="generator" content={Astro.generator} />
    <link rel="alternate" type="application/rss+xml" title={`${site.name} RSS`} href={new URL('/rss.xml', Astro.site)} />
    <title>{pageTitle}</title>
  </head>
  <body class:list={[reading && 'reading-page']}>
    <header class="site-header">
      <div class="site-header__masthead">
        {/* 字标与刊名共用首页入口；内联 SVG 保持现有路径。 */}
        <a class="site-name" href="/" aria-label={`${site.name}首页`}>
          <svg class="site-name__logo" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 966 367" width="966" height="367" aria-hidden="true" focusable="false"><path d="M 145.252 15.002 C 90.926 20.705, 44.247 53.212, 21.535 101.159 C 19.041 106.424, 17 111.191, 17 111.752 C 17 112.858, 31.775 113.586, 74.500 114.585 L 100.500 115.193 103.500 111.991 C 107.615 107.601, 116.956 101.348, 124.536 97.911 C 134.587 93.354, 144.573 90.992, 156.500 90.353 C 187.512 88.691, 214.567 101.511, 230.464 125.402 C 235.970 133.678, 241.542 146.314, 240.458 148.068 C 240.129 148.601, 229.913 149, 216.606 149 C 203.804 149, 165.581 149.299, 131.665 149.664 L 70 150.328 70 183.031 L 70 215.734 153.986 216.186 C 200.179 216.435, 238.268 216.935, 238.630 217.297 C 239.818 218.484, 229.113 238.360, 223.723 244.974 C 212.506 258.739, 194.884 270.052, 177.500 274.649 C 167.817 277.209, 142.349 277.252, 133.121 274.723 C 118.914 270.830, 107.852 265.062, 98.322 256.577 L 92.792 251.655 53.411 251.193 L 14.030 250.731 17.382 259.271 C 24.659 277.806, 36.920 296.679, 51 311.017 C 70.780 331.159, 93.863 343.602, 123.741 350.227 C 137.251 353.222, 173.301 353.453, 188.500 350.642 C 240.080 341.099, 282.840 311.644, 307.360 268.764 C 311.769 261.053, 318.663 242.931, 321.408 231.838 C 326.629 210.734, 328.538 179.114, 325.956 156.500 C 317.267 80.387, 269.795 29.866, 194.945 17.077 C 181.564 14.791, 157.024 13.766, 145.252 15.002 M 843 50.203 C 811.716 95.646, 792.004 124.262, 766.678 161 C 755.113 177.775, 744.042 193.857, 742.076 196.738 C 740.109 199.619, 738.163 201.982, 737.750 201.988 C 737.337 201.995, 737 160.375, 737 109.500 L 737 17 697.352 17 L 657.703 17 658.370 182.046 L 659.036 347.092 697.150 347.023 C 718.113 346.986, 735.542 346.783, 735.882 346.573 C 736.222 346.363, 744.150 334.890, 753.500 321.078 C 788.879 268.816, 834.087 202.540, 849.500 180.337 L 865.500 157.289 865.755 252.144 L 866.010 347 908.843 347 L 951.676 347 951.269 182.750 C 951.044 92.412, 950.681 17.938, 950.462 17.250 C 950.151 16.276, 940.851 16.007, 908.281 16.034 L 866.500 16.067 843 50.203 M 442.889 18.732 L 345.278 19.010 344.636 43.755 C 343.804 75.799, 342.557 344.402, 343.231 346.160 C 343.658 347.273, 362.522 347.413, 454.622 346.985 L 565.500 346.470 573.500 344.161 C 606.341 334.679, 628.963 312.390, 637.606 280.998 C 640.287 271.261, 640.033 248.300, 637.126 237.500 C 631.102 215.127, 615.392 194.364, 595.087 181.940 L 589.674 178.628 592.052 177.064 C 612.796 163.418, 626.524 143.437, 631.411 119.778 C 633.418 110.059, 633.453 93.320, 631.486 83.815 C 628.262 68.242, 616.881 50.050, 603.796 39.557 C 591.452 29.659, 571.351 21.134, 556.740 19.602 C 546.162 18.493, 540.882 18.452, 442.889 18.732 M 418.467 92.226 C 418.192 92.943, 418.086 105.673, 418.233 120.515 L 418.500 147.500 475.500 147.500 C 531.233 147.500, 532.600 147.454, 537 145.408 C 543.780 142.256, 547.561 138.566, 550.942 131.800 C 558.372 116.930, 552.487 100.748, 537.051 93.606 C 532.618 91.555, 531.026 91.492, 475.734 91.211 C 429.786 90.977, 418.872 91.171, 418.467 92.226 M 418 245.469 L 418 274 474.962 274 C 529.881 274, 532.121 273.927, 537.387 271.956 C 543.955 269.499, 549.798 264.085, 553.081 257.415 C 555.976 251.532, 556.304 240.740, 553.766 234.860 C 551.475 229.554, 545.362 223.233, 539.563 220.172 L 534.500 217.500 476.250 217.219 L 418 216.938 418 245.469" fill="#232323" fill-rule="evenodd"/></svg>
          <span class="site-name__text">{site.name}</span>
        </a>
        <nav class="site-header__nav" aria-label="主要导航">
          {site.navigation.map((item) => (
            <a href={item.href} aria-current={current(item.href) ? 'page' : undefined}>{item.label}</a>
          ))}
        </nav>
      </div>
    </header>
    <main><slot /></main>
    <footer class="site-footer">
      <div class="site-footer__inner">
        <a class="site-footer__name" href="/">{site.name}</a>
        <nav aria-label="页脚导航">
          {site.footer.map((item) => <a href={item.href}>{item.label}</a>)}
        </nav>
      </div>
    </footer>
  </body>
</html>
