---
import '../styles/global.css';
import { site } from '../lib/editorial';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = site.description,
} = Astro.props;
const pageTitle = title === site.name ? title : `${title}｜${site.name}`;
const currentPath = Astro.url.pathname;
const current = (href: string) => (
  currentPath === href || currentPath.startsWith(`${href}/`)
);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="site-header__masthead">
        <a class="site-name" href="/" aria-label={`${site.name}首页`}>
          <span class="site-name__text">{site.name}</span>
        </a>
        <nav aria-label="主要导航">
          {site.navigation.map((item) => (
            <a href={item.href} aria-current={current(item.href) ? 'page' : undefined}>{item.label}</a>
          ))}
        </nav>
      </div>
    </header>
    <main><slot /></main>
    <footer class="site-footer">
      <div class="site-footer__inner">
        {site.navigation.some((section) => section.children) && (
          <nav class="site-footer__nav" aria-label="页脚导航">
            {site.navigation.filter((section) => section.children).map((section) => (
              <div class="site-footer__group">
                <span class="site-footer__top">{section.label}</span>
                <ul>
                  {section.children!.map((child) => (
                    <li><a href={child.href} aria-current={current(child.href) ? 'page' : undefined}>{child.label}</a></li>
                  ))}
                </ul>
              </div>
            ))}
          </nav>
        )}
        <p class="site-footer__note">
          {site.organization}维护。网站只呈现获得对应版本公开许可的文本，边界见<a href="/about">项目与权利</a>。
        </p>
      </div>
    </footer>
  </body>
</html>
