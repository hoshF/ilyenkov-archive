{
  "name": "ilyenkov-archive",
  "type": "module",
  "version": "0.0.1",
  "description": "中文伊里因科夫小组的公共网站与出版锚点",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run publication:prepare && astro dev --background",
    "dev:status": "astro dev status",
    "dev:logs": "astro dev logs",
    "dev:stop": "astro dev stop",
    "build": "npm run publication:prepare && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "publication:prepare": "node scripts/sync-translations.mjs",
    "publication:sync": "node scripts/sync-translations.mjs",
    "publication:check": "node scripts/sync-translations.mjs --check",
    "check": "npm run publication:prepare && astro check",
    "test": "npm run publication:prepare && vitest run"
  },
  "dependencies": {
    "astro": "^7.2.2",
    "gray-matter": "^4.0.3",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^26.2.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
