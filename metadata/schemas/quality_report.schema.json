{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quality_report.schema.json",
  "title": "Digitization Quality Report",
  "type": "object",
  "required": ["schema_version", "status", "checks", "unresolved_issues"],
  "properties": {
    "schema_version": { "const": 1 },
    "status": { "enum": ["pending", "failed", "passed"] },
    "checks": {
      "oneOf": [
        { "type": "object" },
        { "type": "array", "items": { "type": "object" } }
      ]
    },
    "unresolved_issues": {
      "type": "array",
      "items": {
        "oneOf": [
          { "type": "string" },
          { "type": "object" }
        ]
      }
    },
    "review_date": { "type": "string" },
    "notes": { "type": "string" }
  },
  "additionalProperties": true
}
